<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Translation: six specialist models are accessed via the server API;
        the 4-language m2m100 model is downloaded from the server on first use.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!--
        Android 11+ 包可见性：允许 App 发现系统 TTS engine。
        不新增任何权限（TTS 不需要 INTERNET）。
        com.google.android.tts 声明用于检测/直达 Google TTS 的
        语音数据安装界面（系统引擎缺俄语等多语言语音时）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.android.tts" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="FourLang ASR"
        android:supportsRtl="true"
        android:theme="@style/Theme.FourLangAsr">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
