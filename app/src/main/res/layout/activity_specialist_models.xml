<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/specialistToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="专项模型" />

    <Button
        android:id="@+id/specialistRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="刷新模型清单" />

    <TextView
        android:id="@+id/specialistServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="服务器地址："
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="总模型是默认主力（覆盖全部 12 个方向）。下载并启用某个专项模型后，对应方向的翻译将优先使用该专项模型；主界面会实时显示当前方向使用哪个引擎。"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/specialistList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/specialistStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="" />

</LinearLayout>
